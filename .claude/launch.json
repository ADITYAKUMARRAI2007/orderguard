{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "orderguard",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "orderguard.app:app", "--port", "8000", "--env-file", ".env"],
      "port": 8000
    },
    {
      "name": "orderguard-frontend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd frontend && npm run dev"],
      "port": 5173
    }
  ]
}
