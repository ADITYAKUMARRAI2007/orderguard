# ---- Razorpay: TEST MODE ONLY. Never live keys. ----
# dashboard.razorpay.com -> Test Mode -> Account & Settings -> API Keys
RZP_KEY_ID=
RZP_KEY_SECRET=
# dashboard.razorpay.com -> Account & Settings -> Webhooks -> add a webhook
# pointed at /api/webhooks/razorpay, subscribe to payment.captured. A
# SEPARATE secret from the key pair above — Razorpay generates it when you
# create the webhook. Optional: without it, the webhook endpoint refuses
# every delivery (fails closed) rather than accepting one it cannot verify.
RZP_WEBHOOK_SECRET=

# ---- LLM: provider-neutral. Swapping providers is a config change. ----
# gemini  -> aistudio.google.com/apikey        (free, no card, native responseSchema)
# groq    -> console.groq.com/keys             (free, no card, OpenAI-compatible)
# stub    -> no key needed; deterministic, offline. Tests always use this.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
# ---- Web search: optional. Widens comparison to shops we cannot buy from. ----
# serper -> serper.dev            (free tier, Google results, no card)
# brave  -> brave.com/search/api  (free tier, independent index)
# stub   -> no key needed; deterministic, offline. Tests use this.
# Leave unset and store search still works; web results are simply absent.
SEARCH_PROVIDER=serper
SEARCH_API_KEY=

# ---- Agent orchestrator: server-side, dual runtime (src/orderguard/agent/). ----
# api          -> AnthropicApiRuntime, uses ANTHROPIC_API_KEY below (or a
#                 user's own BYOK key, entered at runtime, never stored here)
# subscription -> SubscriptionAgentRuntime, uses CLAUDE_CODE_OAUTH_TOKEN below
AGENT_RUNTIME=api
# console.anthropic.com -> API Keys. Needed for AGENT_RUNTIME=api. Without it,
# /api/agent/run and /api/agent/missions/run return 503 (fails closed), never
# a crash — matching LLM_PROVIDER's own behavior above.
ANTHROPIC_API_KEY=
# Generate with: claude setup-token (run in your own terminal — this project
# never runs or automates that step). Needed for AGENT_RUNTIME=subscription.
CLAUDE_CODE_OAUTH_TOKEN=
# Encrypts connector bearer tokens at rest (Swiggy backend OAuth, GitHub PAT)
# — see src/orderguard/agent/connector_accounts.py. Generate your own with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTOR_TOKEN_KEY=
