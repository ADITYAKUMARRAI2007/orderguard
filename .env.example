# ---- Razorpay: TEST MODE ONLY. Never live keys. ----
# dashboard.razorpay.com -> Test Mode -> Account & Settings -> API Keys
RZP_KEY_ID=
RZP_KEY_SECRET=

# ---- LLM: provider-neutral. Swapping providers is a config change. ----
# gemini  -> aistudio.google.com/apikey        (free, no card, native responseSchema)
# groq    -> console.groq.com/keys             (free, no card, OpenAI-compatible)
# stub    -> no key needed; deterministic, offline. Tests always use this.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
# ---- Web search: optional. Widens comparison to shops we cannot buy from. ----
# serper -> serper.dev            (free tier, Google results, no card)
# brave  -> brave.com/search/api  (free tier, independent index)
# stub   -> no key needed; deterministic, offline. Tests use this.
# Leave unset and store search still works; web results are simply absent.
SEARCH_PROVIDER=
SEARCH_API_KEY=
